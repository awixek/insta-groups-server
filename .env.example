# Supabase (find in Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (for AI moderation + description generation)
GROQ_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random secret (any long string). Vercel Cron sends it so only Vercel can run /api/cron/check-links
CRON_SECRET=

# Optional but recommended: global rate limiting (free at upstash.com -> Redis -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shown on Terms / Privacy / Editorial pages (India IT Rules 2021 grievance officer)
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=


# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
